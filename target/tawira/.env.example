# Copy to target/tawira/.env (gitignored) and fill in.
# <GATEWAY> = the kind Docker network's IPv4 gateway, i.e. the host as the pods see it.
SUPABASE_URL=http://<GATEWAY>:54321
SUPABASE_PUBLISHABLE_KEY=<from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
PUBLIC_APP_URL=http://127.0.0.1:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://<GATEWAY>:4318
OTEL_SERVICE_NAME=atlas-demo-api